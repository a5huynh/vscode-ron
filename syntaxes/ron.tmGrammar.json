{
  "scopeName": "source.ron",
  "patterns": [
    { "include": "#expression" }
  ],
  "repository": {
    "expression": {
      "patterns": [
        { "include": "#attribute" },
        { "include": "#array" },
        { "include": "#block_comment" },
        { "include": "#constant" },
        { "include": "#dictionary" },
        { "include": "#line_comment" },
        { "include": "#number" },
        { "include": "#range" },
        { "include": "#raw_string" },
        { "include": "#struct-field" },
        { "include": "#option" },
        { "include": "#struct-name" },
        { "include": "#object" },
        { "include": "#string" },
        { "include": "#character" },
        { "include": "#enum-variant" }
      ]
    },
    "attribute": {
      "comment": "Extensions attribute, e.g. #![enable(implicit_some)]",
      "name": "meta.attribute.ron",
      "begin": "(#)\\s*(!)\\s*(\\[)",
      "end": "\\]",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.ron" },
        "2": { "name": "punctuation.definition.attribute.ron" },
        "3": { "name": "punctuation.definition.attribute.begin.ron" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.attribute.end.ron" }
      },
      "patterns": [
        { "include": "#block_comment" },
        { "include": "#line_comment" },
        {
          "begin": "\\b(enable)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "keyword.other.attribute.ron" },
            "2": { "name": "punctuation.section.parens.begin.ron" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.parens.end.ron" }
          },
          "patterns": [
            { "include": "#block_comment" },
            { "include": "#line_comment" },
            { "match": "[A-Za-z_][A-Za-z_0-9]*", "name": "support.constant.extension.ron" },
            { "match": ",", "name": "punctuation.separator.attribute.ron" }
          ]
        }
      ]
    },
    "array": {
      "name": "meta.structure.array.ron",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.section.array.begin.ron" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.array.end.ron" }
      },
      "patterns": [
        { "include": "#value" },
        { "include": "#option" },
        { "include": "#struct-name" },
        { "include": "#enum-variant" },
        { "match": ",", "name": "punctuation.separator.array.ron" }
      ]
    },
    "block_comment": {
      "name": "comment.block.ron",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        { "include": "#block_comment" }
      ]
    },
    "constant": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.ron"
    },
    "dictionary": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.dictionary.begin.ron" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.dictionary.end.ron" }
      },
      "patterns": [
        { "include": "#value" },
        { "include": "#option" },
        { "include": "#struct-name" },
        { "include": "#object" },
        { "include": "#enum-variant" },
        { "match": ",", "name": "punctuation.separator.dictionary.ron" },
        { "match": ":", "name": "punctuation.separator.dictionary.key-value.ron" }
      ]
    },
    "line_comment": {
      "name": "comment.line.double-slash.ron",
      "begin": "//",
      "end": "$"
    },
    "struct-field": {
      "comment": "Struct field key: identifier followed by :",
      "match": "([a-z_][A-Za-z_0-9]*)\\s*(:)",
      "captures": {
        "1": { "name": "variable.other.member.ron" },
        "2": { "name": "punctuation.separator.key-value.ron" }
      }
    },
    "option": {
      "match": "\\b(?:Some|None)\\b",
      "name": "entity.name.type.option.ron"
    },
    "struct-name": {
      "comment": "Struct/type name: capitalized identifier typically followed by ( or {",
      "match": "[A-Z][A-Za-z_0-9]*",
      "name": "entity.name.type.ron"
    },
    "enum-variant": {
      "comment": "Enum variant or field name (lowercase identifier not followed by :)",
      "match": "[a-z_][A-Za-z_0-9]*",
      "name": "entity.name.tag.ron"
    },
    "object": {
      "begin": "\\(",
      "end":  "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.ron" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.ron" }
      },
      "patterns": [
        { "include": "#value" },
        { "include": "#dictionary" },
        { "include": "#struct-field" },
        { "include": "#option" },
        { "include": "#struct-name" },
        { "include": "#enum-variant" },
        { "include": "#object" },
        { "match": ",", "name": "punctuation.separator.parens.ron" }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "Special floats: inf, NaN (not when used as a field name)",
          "match": "(?<!\\w)[+-]?\\b(?:inf|NaN)(f32|f64)?\\b(?!\\s*:)",
          "name": "constant.language.float.ron",
          "captures": {
            "1": {
              "name": "storage.type.numeric.ron"
            }
          }
        },
        {
          "comment": "Hexadecimal integer",
          "match": "(?<!\\w)[+-]?\\b0x[0-9a-fA-F][0-9a-fA-F_]*((?:[iu](?:8|16|32|64|128)))?\\b",
          "name": "constant.numeric.hex.ron",
          "captures": {
            "1": {
              "name": "storage.type.numeric.ron"
            }
          }
        },
        {
          "comment": "Binary integer",
          "match": "(?<!\\w)[+-]?\\b0b[01][01_]*((?:[iu](?:8|16|32|64|128)))?\\b",
          "name": "constant.numeric.binary.ron",
          "captures": {
            "1": {
              "name": "storage.type.numeric.ron"
            }
          }
        },
        {
          "comment": "Octal integer",
          "match": "(?<!\\w)[+-]?\\b0o[0-7][0-7_]*((?:[iu](?:8|16|32|64|128)))?\\b",
          "name": "constant.numeric.octal.ron",
          "captures": {
            "1": {
              "name": "storage.type.numeric.ron"
            }
          }
        },
        {
          "comment": "Float or decimal integer: 1, 1.5, 1., .5, 1e10, with optional type suffix. `1..2` is a range, not `1.` + `.2`",
          "match": "(?<!\\w)[+-]?(?:\\b[0-9][0-9_]*(?:\\.(?!\\.)(?:[0-9][0-9_]*)?)?|(?<!\\.)\\.[0-9][0-9_]*)(?:[eE][+-]?[0-9_]*[0-9][0-9_]*)?((?:[iu](?:8|16|32|64|128))|f(?:32|64))?(?!\\w)",
          "name": "constant.numeric.ron",
          "captures": {
            "1": {
              "name": "storage.type.numeric.ron"
            }
          }
        }
      ]
    },
    "range": {
      "match": "\\.\\.=?",
      "name": "keyword.operator.range.ron"
    },
    "raw_string": {
      "comment": "Raw (byte) strings with any number of #: r\"...\", r#\"...\"#, br##\"...\"##",
      "name": "string.quoted.other.raw.ron",
      "begin": "\\b(b?r)(#*)(\\\")",
      "end": "(\\\")(\\2)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.ron"
        },
        "2": {
          "name": "punctuation.definition.string.begin.ron"
        },
        "3": {
          "name": "punctuation.definition.string.begin.ron"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.ron"
        },
        "2": {
          "name": "punctuation.definition.string.end.ron"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.ron",
      "begin": "(?<!\\w)(b?)(\\\")",
      "end": "\"",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.ron"
        },
        "2": {
          "name": "punctuation.definition.string.begin.ron"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ron"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "character": {
      "name": "string.quoted.single.ron",
      "begin": "(?<!\\w)(b?)(')",
      "end": "'",
      "contentName": "constant.character.ron",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.ron"
        },
        "2": {
          "name": "punctuation.definition.string.begin.ron"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ron"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "value": {
      "patterns": [
        { "include": "#array" },
        { "include": "#block_comment" },
        { "include": "#constant" },
        { "include": "#dictionary" },
        { "include": "#line_comment" },
        { "include": "#number" },
        { "include": "#range" },
        { "include": "#object" },
        { "include": "#raw_string" },
        { "include": "#string" },
        { "include": "#character" }
      ]
    },
    "escapes": {
      "comment": "escapes: \\n \\r \\t \\0 \\\\ \\' \\\", byte \\xHH, unicode \\u{H..HHHHHH}",
      "name": "constant.character.escape.ron",
      "match": "(\\\\)(?:(x[0-9a-fA-F]{2})|(u(\\{)[0-9a-fA-F]{1,6}(\\}))|.)",
      "captures": {
        "1": {
          "name": "constant.character.escape.backslash.ron"
        },
        "2": {
          "name": "constant.character.escape.bit.ron"
        },
        "3": {
          "name": "constant.character.escape.unicode.ron"
        },
        "4": {
          "name": "constant.character.escape.unicode.punctuation.ron"
        },
        "5": {
          "name": "constant.character.escape.unicode.punctuation.ron"
        }
      }
    }
  }
}
